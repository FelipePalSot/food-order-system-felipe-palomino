{
  "title": "Food Order System - Microservicios",
  "uid": "food-order-dashboard",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests por Segundo (todos los servicios)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count[1m])",
          "legendFormat": "{{instance}} - {{uri}} [{{status}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latencia HTTP p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[1m])) * 1000",
          "legendFormat": "{{instance}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Errores HTTP (5xx) por servicio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{status=~'5..'}[1m])",
          "legendFormat": "{{instance}} - {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "JVM - Uso de Memoria Heap",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area='heap'} / 1024 / 1024",
          "legendFormat": "{{instance}} - {{id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MB"
        }
      }
    },
    {
      "id": 5,
      "title": "JVM - Threads Activos",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU Usage por servicio",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "process_cpu_usage * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Conexiones BD activas",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{instance}} - activas",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle",
          "legendFormat": "{{instance}} - idle",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Health de servicios",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      }
    }
  ]
}

